# ==========================================================
# Backend
# ==========================================================

PORT=5000

BASE_URL=http://localhost:${PORT}/api

BACKEND_TIMEOUT=30

EMAIL=rl_agent_test@sandbox.com
PASSWORD=Password123!


# ==========================================================
# Environment
# ==========================================================

MAX_STEPS_PER_EPISODE=20
RANDOM_SEED=42

# Used by: python main.py run-all
EXPERIMENT_SEEDS=42,33,24,50,10

# Base name for the combined suite folders.
EXPERIMENT_SUITE_NAME=final_dissertation


# ==========================================================
# PPO Training
# ==========================================================

TOTAL_EPISODES=1000
EVALUATION_EPISODES=100

GAMMA=0.99
GAE_LAMBDA=0.95

LEARNING_RATE=0.0003

BATCH_SIZE=64
UPDATE_INTERVAL=256

PPO_EPOCHS=10
CLIP_EPSILON=0.2

HIDDEN_NEURON_SIZE=256

# PPO exploration
ENTROPY_COEF=0.01

# PPO gradient stability
MAX_GRAD_NORM=0.5

SAVE_EVERY=100
LOG_EVERY=10


# ==========================================================
# Ollama / LLM
# ==========================================================

OLLAMA_BASE_URL=http://localhost:11434

LLM_MODEL=llama3

OLLAMA_TIMEOUT=120

LLM_TEMPERATURE=0.1

LLM_USE_CACHE=true


# ==========================================================
# LLM Reward Guidance
# ==========================================================

GUIDANCE_BONUS=1.0